{
  "name": "ourresearch-website-2",
  "version": "0.1.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "serve": "nuxt dev",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 nuxt build",
    "start": "node .output/server/index.mjs",
    "heroku-cleanup": "rm -rf node_modules",
    "preview": "nuxt preview",
    "lint": "eslint --ext .js,.vue src",
    "qa": "node scripts/qa/site-qa.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "//deps-notes": {
    "@observablehq/plot": "Kept-without-current-consumer after oxjob #250 was rolled back on 2026-05-24. The chart feature shipped, then retreated when embedded counts_by_year proved unreliable. Plot (MIT, Tufte-friendly defaults, ~87 KiB gz contribution) is preserved here intentionally for upcoming OpenAlex infovis work. Don't auto-prune or depcheck-remove.",
    "unplugin": "oxjob #1689: @nuxt/vite-builder 4.5.2 does `import \"unplugin\"` without declaring it; it worked only while a Vue CLI package hoisted unplugin@1 to the root. Keep until Nuxt declares it (nuxt build fails with 'Cannot find package unplugin' otherwise).",
    "compression": "oxjob #1689: used by server/lib/front-door.ts (server.js's compression(), first in the stack). Not a leftover of the Vue CLI server."
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@mdi/font": "^7.2.96",
    "@observablehq/plot": "^0.6.17",
    "@sentry/vue": "^9.29.0",
    "@unhead/vue": "^3.3.1",
    "axios": "^0.27.2",
    "body-scroll-lock": "^2.7.1",
    "compression": "^1.8.1",
    "country-code-lookup": "^0.0.20",
    "crypto-js": "^4.2.0",
    "iso-639-1": "^3.1.0",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.18.1",
    "marked": "^15.0.12",
    "material-colors": "^1.2.6",
    "millify": "^5.0.0",
    "nuxt": "4.5.2",
    "peggy": "^4.2.0",
    "pluralize": "^8.0.0",
    "qrcode.vue": "^3.0.0",
    "sanitize-html": "^2.7.2",
    "sass": "^1.73.0",
    "short-uuid": "^4.2.2",
    "timeago.js": "^4.0.2",
    "v-scroll-lock": "^1.3.1",
    "vue": "^3.5.0",
    "vue-click-outside": "^1.1.0",
    "vue-flag-icon": "^2.1.0",
    "vue-json-pretty": "^2.5.0",
    "vue-pluralize": "^0.0.2",
    "vue-router": "^5.2.0",
    "vue-sanitize": "^0.2.2",
    "vue-shortkey": "^3.1.7",
    "vue-typer": "^1.2.0",
    "vuetify": "^3.12.1",
    "vuex": "^4.0.2",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.27.5",
    "@babel/preset-env": "^7.29.7",
    "@mdi/font": "^7.2.96",
    "@vue/compiler-sfc": "^3.4.0",
    "cypress": "^14.4.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.0.0",
    "eslint-plugin-vuetify": "^2.5.2",
    "madge": "^8.0.0",
    "node-notifier": "^10.0.1",
    "unplugin": "^3.4.0",
    "vite": "^7.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^3.2.4"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2020": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended",
      "plugin:vuetify/base"
    ],
    "plugins": [
      "vuetify"
    ],
    "parser": "vue-eslint-parser",
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false,
      "babelOptions": {
        "presets": [
          "@babel/preset-env"
        ]
      }
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
